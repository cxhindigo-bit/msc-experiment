# OpenAI API access. Copy this file to .env and add your own key.
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# Synthetic dialogue generation reported in the dissertation.
DIALOGUE_LLM_MODEL=gpt-4.1-nano

# Initial-answer classification and the formal Pure-LLM condition.
PIPELINE_LLM_MODEL=gpt-4.1-mini
PIPELINE_LLM_THINKING=not_applicable

# Keep the formal output directory unless intentionally running a separate study.
PIPELINE_OUTPUT_DIR=outputs
